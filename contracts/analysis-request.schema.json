{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearpolicy.local/contracts/analysis-request.schema.json",
  "title": "Privacy policy analysis request",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "source_type", "text", "clauses"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_type": { "type": "string", "enum": ["text", "html", "pdf"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "text", "start_offset", "end_offset"],
        "properties": {
          "clause_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "section_heading": { "type": ["string", "null"], "maxLength": 500 },
          "start_offset": { "type": "integer", "minimum": 0 },
          "end_offset": { "type": "integer", "minimum": 0 },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "uniqueItems": true },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
